{
    "version": 6,   
    "configurePresets": [
        {
            "name": "default",
            "inherits": "base",
            "hidden": true,
            "environment": {
                "VCPKG_ROOT": "/fmw/3rd/vcpkg"
            },
            "cacheVariables": {
                "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed",
                "VCPKG_MANIFEST_INSTALL": "ON"
            }
        },
        {
            "name": "dbg",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "rel",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ]
}